# ============================================================
# CloudForge Identity Service - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file to git.

# Required: RSA private key in PEM format (use scripts/generate_keys.py)
# You can paste the whole multi-line PEM or use \n for newlines.
RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"

# Optional overrides
IDENTITY_ISSUER=https://identity.cloudforge.internal
IDENTITY_KEY_ID=cloudforge-key-2026-v1
TOKEN_TTL_SECONDS=3600

# Client secrets (one per client in the allowlist)
# Format: CLIENT_{CLIENT_ID_UPPER_WITH_UNDERSCORES}_SECRET
CLIENT_INGEST_STUDIO_SECRET=change-me-ingest-secret-very-long-and-random
CLIENT_KNOWLEDGE_STUDIO_SECRET=change-me-knowledge-secret-very-long-and-random
CLIENT_NOVA_STUDIO_SECRET=change-me-nova-secret-very-long-and-random
